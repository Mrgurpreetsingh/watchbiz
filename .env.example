# ═══════════════════════════════════════════════════════════════
# WatchBiz - Environment Variables Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to:
#   - .env.local (local development - highest priority)
#   - .env.test (testing environment)
#   - .env.production (production - via deployment platform)
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# 🗄️  Database
# ───────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://watchbiz_user:password@localhost:5432/watchbiz_dev?schema=public"

# Optional: Direct URL for Prisma Migrate (bypasses connection pooling)
# DIRECT_URL="postgresql://watchbiz_user:password@localhost:5432/watchbiz_dev"

# ───────────────────────────────────────────────────────────────
# 🔐 Authentication (NextAuth v5)
# ───────────────────────────────────────────────────────────────
# Base URL of your application
NEXTAUTH_URL="http://localhost:3000"

# Secret for JWT signing (MUST be 32+ characters)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# ───────────────────────────────────────────────────────────────
# 💳 Stripe Payment
# ───────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Webhook signing secret (get from Stripe CLI or webhook settings)
# Generate with: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET="whsec_..."

# ───────────────────────────────────────────────────────────────
# 📧 Email (Resend - Optional)
# ───────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys
# RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_FROM="noreply@watchbiz.com"

# ───────────────────────────────────────────────────────────────
# 🌐 Application URLs
# ───────────────────────────────────────────────────────────────
# Public URL of your application (for emails, OG images, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ───────────────────────────────────────────────────────────────
# 🧪 Testing (CI/CD)
# ───────────────────────────────────────────────────────────────
# Playwright test base URL
PLAYWRIGHT_TEST_BASE_URL="http://localhost:3000"

# Codecov token (for coverage reporting)
# CODECOV_TOKEN="your-codecov-token"

# ───────────────────────────────────────────────────────────────
# 🚀 Deployment (Vercel - CI/CD only)
# ───────────────────────────────────────────────────────────────
# For GitHub Actions workflows
# VERCEL_TOKEN="your-vercel-token"
# VERCEL_ORG_ID="your-vercel-org-id"
# VERCEL_PROJECT_ID="your-vercel-project-id"

# ───────────────────────────────────────────────────────────────
# 📊 Analytics & Monitoring (Optional)
# ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
# SENTRY_DSN="https://your-sentry-dsn"

# ───────────────────────────────────────────────────────────────
# 🔧 Development
# ───────────────────────────────────────────────────────────────
NODE_ENV="development"

# ═══════════════════════════════════════════════════════════════
# 📝 Notes
# ═══════════════════════════════════════════════════════════════
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Never commit .env.local or .env.production to git
# - Priority: .env.local > .env.development > .env
# - Use different Stripe keys for test/production
# - Rotate secrets regularly for security
# ═══════════════════════════════════════════════════════════════
